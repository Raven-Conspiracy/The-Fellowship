# =============================================================================
# The Fellowship — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# =============================================================================
# Apollo (bridge to Striveworks)
# =============================================================================
# Base URL of the Palantir Apollo instance
APOLLO_BASE_URL=https://your-apollo-instance.palantirfoundry.com

# Apollo authentication token (dev token — Apollo-managed in prod)
APOLLO_TOKEN=

# Apollo request timeout in milliseconds
APOLLO_TIMEOUT_MS=30000

# Apollo retry configuration
APOLLO_MAX_RETRIES=3
APOLLO_RETRY_DELAY_MS=1000

# =============================================================================
# Striveworks Agents
# =============================================================================
# Environment tag for Striveworks agent resolution
STRIVEWORKS_ENV=dev

# Comma-separated list of registered agent names
STRIVEWORKS_REGISTERED_AGENTS=classifier,analyzer,summarizer,escalator

# =============================================================================
# Foundry
# =============================================================================
# Base URL of the Foundry enrollment
FOUNDRY_URL=https://your-enrollment.palantirfoundry.com

# Foundry service token for API access
FOUNDRY_TOKEN=

# Foundry Ontology rid (resource identifier)
FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.0000-0000-0000-0000

# Foundry dataset rid for graph state persistence
FOUNDRY_DATASET_RID=ri.foundry.main.dataset.0000-0000-0000-0000

# =============================================================================
# Orchestration Runtime
# =============================================================================
# Deployment environment: dev | staging | prod
ORCHESTRATION_ENV=dev

# Enable structured JSON logging (true in staging/prod)
STRUCTURED_LOGGING=false

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Persist graph state checkpoints to Foundry dataset (Phase 3)
GRAPH_STATE_PERSIST=false

# Maximum nodes to execute in parallel
GRAPH_MAX_PARALLELISM=5

# Default execution timeout in milliseconds
GRAPH_EXECUTION_TIMEOUT_MS=300000

# =============================================================================
# Circuit Breaker
# =============================================================================
# Failure threshold before circuit opens
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Cooldown period before half-open attempt (ms)
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Maximum requests allowed in half-open state
CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=3

# =============================================================================
# Retry Policy (Global Defaults)
# =============================================================================
# Maximum retry attempts
RETRY_MAX_ATTEMPTS=3

# Base delay between retries (ms)
RETRY_BASE_DELAY_MS=500

# Maximum delay cap (ms)
RETRY_MAX_DELAY_MS=10000

# Exponential backoff multiplier
RETRY_BACKOFF_MULTIPLIER=2

# =============================================================================
# Idempotency
# =============================================================================
# Enable idempotency key generation for graph executions
IDEMPOTENCY_ENABLED=true

# TTL for idempotency keys in seconds
IDEMPOTENCY_KEY_TTL_SECONDS=3600
